{# Custom RSS feed template for Zola's configured blog section. #}
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ config.title | escape_xml | safe }}</title>
    <link>{% if section %}{{ section.permalink | escape_xml | safe }}{% else %}{{ config.base_url | escape_xml | safe }}{% endif %}</link>
    <description>{{ config.description | escape_xml | safe }}</description>
    <atom:link rel="self" type="application/rss+xml" href="{{ feed_url | escape_xml | safe }}" />
    <language>{{ lang | escape_xml | safe }}</language>
    <generator>Zola</generator>
    {% if last_updated is defined %}<lastBuildDate>{{ last_updated | date(format="%a, %d %b %Y %H:%M:%S %z") }}</lastBuildDate>{% endif %}
    {% for page in pages %}
    <item>
      <title>{{ page.title | escape_xml | safe }}</title>
      <link>{{ page.permalink | escape_xml | safe }}</link>
      <guid isPermaLink="true">{{ page.permalink | escape_xml | safe }}</guid>
      {% if page.date %}<pubDate>{{ page.date | date(format="%a, %d %b %Y %H:%M:%S %z") }}</pubDate>{% endif %}
      {% if page.summary %}<description>{{ page.summary | striptags | escape_xml | safe }}</description>{% else %}<description>{{ page.content | striptags | escape_xml | safe }}</description>{% endif %}
    </item>
    {% endfor %}
  </channel>
</rss>
