{
  "name": "John's Zola site",
  "dockerComposeFile": "compose.yaml",
  "service": "site",
  "workspaceFolder": "/workspaces/john-cd.github.io",
  "forwardPorts": [1111],
  "portsAttributes": {
    "1111": {
      "label": "Zola preview",
      "onAutoForward": "openBrowser"
    }
  },
  "remoteUser": "vscode",
  "postCreateCommand": "git submodule update --init --recursive"
}
