// VS Code opens the project-scoped Compose service and forwards its local Zola preview.
{
  "name": "john-cd-github-io - John's Zola site",
  "dockerComposeFile": "compose.yaml",
  "service": "john-cd-github-io-site",
  "workspaceFolder": "/workspaces/john-cd.github.io",
  "forwardPorts": [1111],
  "portsAttributes": {
    "1111": {
      "label": "Zola preview",
      "onAutoForward": "openBrowser"
    }
  },
  "remoteUser": "vscode",
  // Initialize the pinned Linkita theme after the workspace is mounted.
  "postCreateCommand": "git submodule update --init --recursive"
}
